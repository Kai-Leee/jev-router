{
  "schema_version": "jev-failure-loop-design/v1",
  "status": "design_only_not_loaded_by_runner",
  "as_of": "2026-10-12",
  "dispatch_enabled": false,
  "sdk_automatic_retries": 0,
  "local_token_cap": null,
  "null_token_cap_means": "No new local token cap; provider limits and accounting checks still apply.",
  "transport_backoff_attempt_cap": null,
  "null_backoff_cap_means": "Not configured, so no automatic retry permission. This is not unlimited retries.",
  "precedence": [
    "outcome_or_accounting_uncertain",
    "schema_body_or_model_context_rejected",
    "http_401_or_404",
    "http_402",
    "confirmed_429_502_503_and_accounting_clear",
    "verification_stale_or_harness_blocked",
    "decision_invalid_or_unknown",
    "public_pass_and_current_independent_failed_or_incomplete",
    "repair_regression",
    "repair_no_change",
    "repair_no_progress",
    "repair_partial_progress",
    "independent_pass_and_public_pass_same_revision",
    "public_pass_and_independent_absent_or_stale"
  ],
  "transitions": [
    {"when": "outcome_or_accounting_uncertain", "next": "reconcile_request", "owner": "controller_and_account_evidence", "requires_before_inference": ["known_outcome", "settled_matching_request"], "same_payload_resend": false},
    {"when": "schema_body_or_model_context_rejected", "next": "rebuild_relevant_input", "owner": "controller", "requires_before_inference": ["changed_request_hash", "source_coverage", "new_preflight"], "same_payload_resend": false},
    {"when": "http_401_or_404", "next": "correct_connection", "owner": "controller_or_account_operator", "requires_before_inference": ["resolved_destination", "authenticated_models_get", "application_configuration_verified"], "same_payload_resend": false},
    {"when": "http_402", "next": "resolve_account", "owner": "account_operator", "requires_before_inference": ["account_state_resolved"], "same_payload_resend": false},
    {"when": "confirmed_429_502_503_and_accounting_clear", "next": "wait_provider", "owner": "controller", "requires_before_inference": ["retry_after_elapsed", "finite_backoff_policy", "known_failed_request"], "same_payload_resend": "only_after_these_gates"},
    {"when": "verification_stale_or_harness_blocked", "next": "restore_verification_evidence", "owner": "controller_or_verifier_maintainer", "requires_before_inference": ["current_revision_checks", "harness_health"], "same_payload_resend": false},
    {"when": "decision_invalid_or_unknown", "next": "collect_missing_decision_evidence", "owner": "controller_then_source_investigator_if_needed", "requires_before_inference": ["new_relevant_evidence_or_changed_candidates", "new_preflight"], "same_payload_resend": false},
    {"when": "public_pass_and_current_independent_failed_or_incomplete", "next": "investigate_public_reproduction", "owner": "source_investigator_and_public_verifier", "requires_before_inference": ["public_requirement_based_reproduction", "no_hidden_grader_details", "new_preflight"], "same_payload_resend": false},
    {"when": "repair_regression", "next": "inspect_new_failure_path", "owner": "source_investigator", "requires_before_inference": ["before_after_failure_diff", "artifact_revision_diff", "finite_causal_candidates"], "same_payload_resend": false},
    {"when": "repair_no_change", "next": "inspect_no_write_cause", "owner": "controller_then_source_investigator_if_needed", "requires_before_inference": ["actual_write_receipt", "worker_outcome", "read_write_scope", "producer_consumer_evidence", "changed_causal_evidence_or_scope", "new_preflight"], "same_payload_resend": false},
    {"when": "repair_no_progress", "next": "inspect_causal_path", "owner": "source_investigator", "requires_before_inference": ["new_causal_evidence", "revised_candidates_or_scope", "new_preflight"], "same_payload_resend": false},
    {"when": "repair_partial_progress", "next": "infer_remaining_owners", "owner": "jev_with_controller_generated_packet", "requires_before_inference": ["current_remaining_public_failures", "existing_owner_candidates", "new_preflight"], "same_payload_resend": false},
    {"when": "independent_pass_and_public_pass_same_revision", "next": "audit_completion_evidence", "owner": "controller", "requires_before_inference": [], "same_payload_resend": false},
    {"when": "public_pass_and_independent_absent_or_stale", "next": "run_independent_checks", "owner": "independent_verifier", "requires_before_inference": [], "same_payload_resend": false}
  ],
  "selection_semantics": "Evaluate current revision evidence, use the first matching predicate in precedence, and treat missing predicate evidence as needs_evidence. A current failed independent result is not absent or stale.",
  "observation_scope": "Latest terminal event bound to the active request and candidate; historical failures are context, not simultaneously active triggers.",
  "same_progress_worker_redispatch_allowed": false,
  "profile_change_alone_sufficient_for_worker_redispatch": false,
  "progress_identity_fields": ["failed_assertion_ids", "artifact_revisions", "relevant_evidence_hash", "candidate_scope_hash", "question_policy_hash", "dispatched_profile"],
  "not_progress": ["new_attempt_id", "new_timestamp", "new_wording_without_changed_evidence", "worker_says_done_without_current_checks"],
  "hidden_grader_details_allowed_in_jev_input": false,
  "official_sources": ["https://jev-ai.pro/docs#errors", "https://docs.typesafe.ai/primitives", "https://docs.typesafe.ai/concepts/how-to-build-with-system-one"]
}
